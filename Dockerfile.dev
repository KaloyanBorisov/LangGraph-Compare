FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    graphviz \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://install.python-poetry.org | python3 -
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

COPY pyproject.toml poetry.lock ./

RUN poetry config virtualenvs.create false \
    && poetry lock \
    && poetry install --with dev,test --no-root \
    && pip install -q jupyter ipykernel langchain-mcp-adapters mcp aiosqlite \
    && pip install -U langgraph-api typing_extensions openai

COPY . .

RUN poetry lock && poetry install --with dev,test

CMD ["bash"]
