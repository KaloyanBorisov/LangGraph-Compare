      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Hierarchical Teams",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/architectures/main_hierarchical_teams.py",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Network Architecture",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/architectures/main_network.py",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Tavily Architecture",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/architectures/main_tavily.py",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Reflexion - Research",
      "type": "debugpy",
